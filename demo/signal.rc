Magic 271485
Revision Verdi_W-2024.09-SP2-3

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 11 1920 789 166 76

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "demo.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

individualSetFormt -File demo.fsdb -HEX /demo_tb/fp_a[7:0]
individualSetFormt -File demo.fsdb -HEX /demo_tb/u_matmul/matrix_A0/addr0[9:0]
individualSetFormt -File demo.fsdb -HEX /demo_tb/add_result[7:0]
individualSetFormt -File demo.fsdb -HEX /demo_tb/u_matmul/u_apb/address_mat_a[9:0]
individualSetFormt -File demo.fsdb -BIN /demo_tb/u_matmul/u_matmul_8x8/exception_flags[4:0]
individualSetFormt -File demo.fsdb -HEX /demo_tb/mult_flags[4:0]
individualSetFormt -File demo.fsdb -HEX /demo_tb/fp_b[7:0]
individualSetFormt -File demo.fsdb -BIN /demo_tb/u_matmul/u_matmul_8x8/flags_tl[4:0]
individualSetFormt -File demo.fsdb -BIN /demo_tb/add_flags[4:0]
individualSetFormt -File demo.fsdb -HEX /demo_tb/mult_result[7:0]

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 1ns

; waveform viewport range
zoom 0.000000 0.000000 1n
cursor 150.000000
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 9
; marker line index
markerPos 38

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "Control"
activeDirFile "" "demo.fsdb"
addSignal -h 16 /demo_tb/clk
addSignal -h 16 -holdScope reset
addGroup "FP8"
addSignal -h 16 -UNSIGNED -HEX /demo_tb/fp_a[7:0]
addSignal -h 16 -UNSIGNED -HEX -holdScope fp_b[7:0]
addSignal -h 16 -holdScope fp_op
addSignal -h 16 -UNSIGNED -HEX -holdScope add_result[7:0]
addSignal -h 16 -UNSIGNED -HEX -holdScope mult_result[7:0]
addSignal -h 16 -UNSIGNED -BIN -holdScope add_flags[4:0]
addSignal -h 16 -UNSIGNED -HEX -holdScope mult_flags[4:0]
addGroup "APB"
addSignal -h 16 -UNSIGNED -HEX /demo_tb/PADDR[9:0]
addSignal -h 16 -holdScope PWRITE
addSignal -h 16 -holdScope PSEL
addSignal -h 16 -holdScope PENABLE
addSignal -h 16 -UNSIGNED -HEX -holdScope PWDATA[15:0]
addSignal -h 16 -UNSIGNED -HEX -holdScope PRDATA[15:0]
addSignal -h 16 -UNSIGNED -HEX /demo_tb/u_matmul/u_apb/address_mat_a[9:0]
addGroup "START/DONE"
addSignal -h 16 /demo_tb/u_matmul/start_mat_mul
addSignal -h 16 -holdScope done_mat_mul
addGroup "FLAGS"
addSignal -h 16 -UNSIGNED -BIN /demo_tb/u_matmul/u_matmul_8x8/flags_tl[4:0]
addSignal -h 16 -UNSIGNED -BIN -holdScope exception_flags[4:0]
addGroup "RAMA0 to Array"
addSignal -h 16 -UNSIGNED -HEX /demo_tb/u_matmul/matrix_A0/addr0[9:0]
addSignal -h 16 -holdScope q0[3:0]
addGroup "Tiles"
addSignal -h 16 /demo_tb/u_matmul/u_matmul_8x8/u_tl/a_pe[3:0]
addSignal -h 16 /demo_tb/u_matmul/u_matmul_8x8/a_tl_tr[3:0]
addSignal -h 16 -holdScope b_tl_bl[3:0]
addSignal -h 16 -holdScope c_tr_tl[3:0]
addGroup "Array to RAMC0"
addSignal -h 16 -UNSIGNED -HEX /demo_tb/u_matmul/matrix_C0/we0[3:0]
addSignal -h 16 -UNSIGNED -HEX -holdScope addr0[9:0]
addSignal -h 16 -holdScope d0[3:0]
addGroup "RESULT C0&C1"
addSignal -h 16 /demo_tb/u_matmul/matrix_C0/ram[64][3:0]
addSignal -h 16 /demo_tb/u_matmul/matrix_C1/ram[64][3:0]
addGroup "--"

; getSignalForm Scope Hierarchy Status
; active file of getSignalForm
activeDirFile "" "demo.fsdb"

GETSIGNALFORM_SCOPE_HIERARCHY_BEGIN
getSignalForm close

"/demo_tb"
"/demo_tb/u_matmul"
"/demo_tb/u_matmul/matrix_C0"
"/demo_tb/u_matmul/matrix_C1"
"/demo_tb/u_matmul/u_apb"
"/demo_tb/u_matmul/u_matmul_8x8"
"/demo_tb/u_matmul/u_matmul_8x8/u_tl"

SCOPE_LIST_BEGIN
"/demo_tb"
"/demo_tb/u_matmul"
"/demo_tb/u_matmul/u_matmul_8x8"
"/demo_tb/u_matmul/matrix_A0"
"/demo_tb/u_matmul/matrix_C0"
"/demo_tb/u_matmul/matrix_C1"
"/demo_tb/u_matmul/u_matmul_8x8/u_bl"
"/demo_tb/u_matmul/u_apb"
"/demo_tb/u_matmul/u_matmul_8x8/u_tl"
SCOPE_LIST_END

GETSIGNALFORM_SCOPE_HIERARCHY_END


